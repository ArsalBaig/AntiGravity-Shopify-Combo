{% comment %}
  Section: Main Collection Product Grid (WizVape Redesign)
  Sticky left sidebar with collapsible filters + 4-column product grid + top sort bar
{% endcomment %}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  if sort_by == blank or sort_by == 'manual'
    assign sort_by = 'best-selling'
  endif
-%}

<div class="collection-page" id="CollectionPage">
  <div class="container">
    <div class="collection-main-layout">
      
      <!-- LEFT SIDEBAR: Sticky Filters Panel -->
      {%- if section.settings.enable_filtering -%}
        <div class="filters-sidebar__overlay" id="FiltersSidebarOverlay"></div>
        <aside class="filters-sidebar" id="FiltersSidebar" aria-label="Filters">
          <div class="filters-sidebar__header">
            <h2 class="filters-sidebar__title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line></svg>
              Filters
            </h2>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="filters-sidebar__clear-all" data-facet-remove>Clear All</a>
              <button type="button" class="filters-sidebar__close-btn" id="FiltersSidebarClose" aria-label="Close filters">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </div>

          <form id="FacetsFilterForm" class="filters-sidebar__form" method="get" action="{{ collection.url }}">
            <input type="hidden" name="sort_by" value="{{ sort_by }}">

            {%- for filter in collection.filters -%}
              <details class="filter-section" id="Details-{{ forloop.index }}-{{ section.id }}" open>
                <summary class="filter-section__summary">
                  <span class="filter-section__title">{{ filter.label | escape }}</span>
                  <svg class="filter-section__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>

                <div class="filter-section__body">
                  {%- case filter.type -%}
                    {%- when 'boolean', 'list' -%}
                      <ul class="filter-options-list" role="list">
                        {%- for value in filter.values limit: 5 -%}
                          <li>
                            <label class="filter-checkbox-label" for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                class="filter-checkbox-input"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span class="filter-checkbox-name">{{ value.label | escape }}</span>
                              <span class="filter-checkbox-count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>

                      {%- if filter.values.size > 5 -%}
                        <div class="filter-extra-options" id="extra-{{ filter.param_name | handle }}">
                          {%- for value in filter.values offset: 5 -%}
                            <label class="filter-checkbox-label" for="Filter-{{ filter.param_name }}-extra-{{ forloop.index }}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="Filter-{{ filter.param_name }}-extra-{{ forloop.index }}"
                                class="filter-checkbox-input"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span class="filter-checkbox-name">{{ value.label | escape }}</span>
                              <span class="filter-checkbox-count">({{ value.count }})</span>
                            </label>
                          {%- endfor -%}
                        </div>
                        <button type="button" class="filter-see-more-btn" onclick="const el=document.getElementById('extra-{{ filter.param_name | handle }}'); const isExp=el.classList.toggle('is-expanded'); this.textContent = isExp ? '- See less' : '+ See more';">+ See more</button>
                      {%- endif -%}

                    {%- when 'price_range' -%}
                      <div class="facet-price" style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.25rem;">
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          placeholder="0"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          style="width: 70px; padding: 4px 6px; border: 1px solid var(--color-border); border-radius: 4px;"
                        >
                        <span>&ndash;</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          style="width: 70px; padding: 4px 6px; border: 1px solid var(--color-border); border-radius: 4px;"
                        >
                        <button type="submit" style="padding: 4px 8px; font-size: 0.75rem; background: var(--color-text-main); color: #fff; border: none; border-radius: 4px; cursor: pointer;">Go</button>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

            <noscript>
              <button type="submit" style="margin-top: 1rem; width: 100%; padding: 0.5rem; background: var(--color-text-main); color: #fff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
                Apply Filters
              </button>
            </noscript>
          </form>
        </aside>
      {%- endif -%}

      <!-- RIGHT AREA: Sort Bar + 4-Column Product Grid -->
      <main class="collection-content-area" id="ProductGridContainer">
        {%- paginate collection.products by section.settings.products_per_page -%}
          
          <!-- Sort Bar -->
          <div class="collection-sort-bar">
            {%- if section.settings.enable_filtering -%}
              <button type="button" class="mobile-filter-btn" id="FacetsDrawerOpen" aria-label="Open Filters">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line></svg>
                <span>Filters</span>
                {%- assign active_facets_count = 0 -%}
                {%- for filter in collection.filters -%}
                  {%- assign active_facets_count = active_facets_count | plus: filter.active_values.size -%}
                  {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.max_value.value != nil -%}
                    {%- assign active_facets_count = active_facets_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if active_facets_count > 0 -%}
                  <span class="mobile-filter-badge" id="FilterBadgeCount">{{ active_facets_count }}</span>
                {%- endif -%}
              </button>
            {%- endif -%}

            <div class="collection-sort-bar__count" id="CollectionProductCount">
              Showing <strong>{{ collection.products_count }}</strong> products
            </div>

            {%- if section.settings.enable_sorting -%}
              <div class="collection-sort-bar__sort-wrap">
                <label for="SortBy" class="collection-sort-bar__label">Sort by:</label>
                <select
                  id="SortBy"
                  class="collection-sort-select"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value }}"
                      {% if option.value == sort_by %}selected="selected"{% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          </div>

          <!-- Product Grid (4 columns) -->
          {%- if collection.products.size == 0 -%}
            <div class="collection-empty">
              <h3 class="collection-empty__title">No products found</h3>
              <p class="collection-empty__text">Try adjusting your filters or search terms.</p>
              <a href="{{ collection.url }}" class="collection-empty__btn">Reset All Filters</a>
            </div>
          {%- else -%}
            <ul class="product-grid-4col" role="list">
              {%- for product in collection.products -%}
                <li class="product-grid__item">
                  {% render 'card-product',
                    product: product,
                    media_aspect_ratio: 'square',
                    show_secondary_image: section.settings.show_secondary_image,
                    index: forloop.index
                  %}
                </li>
              {%- endfor -%}
            </ul>

            <!-- Pagination -->
            {%- if paginate.pages > 1 -%}
              <nav class="pagination" role="navigation" aria-label="Pagination" style="margin-top: 2.5rem; display: flex; justify-content: center;">
                <ul class="pagination__list" role="list" style="display: flex; gap: 0.35rem; list-style: none; padding: 0;">
                  {%- if paginate.previous -%}
                    <li><a href="{{ paginate.previous.url }}" class="brand-tab-btn" data-pagination-link>&larr; Previous</a></li>
                  {%- endif -%}
                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}" class="brand-tab-btn" data-pagination-link>{{ part.title }}</a>
                      {%- else -%}
                        <span class="brand-tab-btn is-active">{{ part.title }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                  {%- if paginate.next -%}
                    <li><a href="{{ paginate.next.url }}" class="brand-tab-btn" data-pagination-link>Next &rarr;</a></li>
                  {%- endif -%}
                </ul>
              </nav>
            {%- endif -%}
          {%- endif -%}

        {%- endpaginate -%}
      </main>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Grid & Sidebar",
  "class": "section-main-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable left sticky filters sidebar"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting dropdown"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    }
  ]
}
{% endschema %}
