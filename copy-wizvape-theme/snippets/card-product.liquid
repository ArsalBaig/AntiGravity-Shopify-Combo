{% comment %}
  Renders a product card (WizVape UX Style)
  Accepts:
  - product: {Object} Product Liquid object
  - media_aspect_ratio: {String} "square" or "portrait"
  - show_secondary_image: {Boolean} Show secondary image on hover
  - index: {Number} Loop index for LCP image optimization
{% endcomment %}

{%- liquid
  assign is_lcp = false
  if index != blank and index <= 4
    assign is_lcp = true
  endif

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if is_lcp
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign has_secondary_image = false
  if show_secondary_image and product.media.size > 1
    assign has_secondary_image = true
  endif

  assign flavour_badge = ''
  assign deal_badge = ''
  assign puff_spec = ''
  assign battery_spec = ''
  assign charge_spec = 'Type-C'
  assign has_led = false

  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'flavour' or tag_lower contains 'flavor'
      assign flavour_badge = tag | upcase
    elsif tag_lower contains 'deal:' or tag_lower contains 'multibuy:' or tag_lower contains 'offer:'
      assign deal_badge = tag | remove: 'deal:' | remove: 'Deal:' | remove: 'multibuy:' | remove: 'offer:' | strip | upcase
    elsif tag_lower contains 'puff'
      assign puff_spec = tag | strip
    elsif tag_lower contains 'mah'
      assign battery_spec = tag | strip
    elsif tag_lower contains 'led' or tag_lower contains 'screen'
      assign has_led = true
    endif
  endfor

  if flavour_badge == '' and product.variants.size > 1
    assign flavour_badge = product.variants.size | append: ' FLAVOURS'
  endif
-%}

<article class="product-card{% unless product.available %} product-card--sold-out{% endunless %}">
  <!-- Badges Row: Flavour Badge (Left) & Multi-Buy Badge (Right) -->
  <div class="product-card__badges">
    {%- if flavour_badge != blank -%}
      <span class="flavour-badge">{{ flavour_badge }}</span>
    {%- else -%}
      <span></span>
    {%- endif -%}

    {%- if deal_badge != blank -%}
      <span class="deal-badge">{{ deal_badge }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <span class="deal-badge">SAVE {{ savings }}%</span>
    {%- else -%}
      <span></span>
    {%- endif -%}
  </div>

  <!-- Centered Product Image Media Wrapper -->
  <div class="product-card__media-wrap">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 500 | image_tag:
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          decoding: 'async',
          widths: '200, 300, 400, 500',
          class: 'product-card__image product-card__image--primary',
          alt: product.featured_media.alt | default: product.title | escape
        }}

        {%- if has_secondary_image -%}
          {{ product.media[1] | image_url: width: 500 | image_tag:
            loading: 'lazy',
            decoding: 'async',
            widths: '200, 300, 400, 500',
            class: 'product-card__image product-card__image--secondary',
            alt: product.media[1].alt | default: product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  <!-- Product Details Content -->
  <div class="product-card__content">
    
    <!-- Specs Row (small grey tags below image) -->
    <div class="product-card__specs-row">
      {%- if puff_spec != blank -%}
        <span class="spec-pill">{{ puff_spec }}</span>
      {%- endif -%}
      {%- if battery_spec != blank -%}
        <span class="spec-pill">{{ battery_spec }}</span>
      {%- endif -%}
      {%- if charge_spec != blank -%}
        <span class="spec-pill">{{ charge_spec }}</span>
      {%- endif -%}
      {%- if has_led -%}
        <span class="spec-pill spec-pill--led">LED Display</span>
      {%- endif -%}
    </div>

    <!-- Product Title -->
    <h3 class="product-card__title">
      <a href="{{ product.url }}" class="product-card__title-link">
        {{ product.title | escape }}
      </a>
    </h3>

    <!-- Price Row -->
    <div class="product-card__price-row">
      <span class="product-price-current">
        {{ product.price | money }}
      </span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-price-compare">
          {{ product.compare_at_price | money }}
        </span>
      {%- endif -%}
    </div>

    <!-- Stock Status -->
    <div class="product-card__stock-status {% if product.available %}stock-status--in{% else %}stock-status--out{% endif %}">
      <span class="stock-dot" aria-hidden="true"></span>
      <span>{% if product.available %}In stock{% else %}Out of stock{% endif %}</span>
    </div>

    <!-- Card Action Button -->
    <a href="{{ product.url }}" class="product-card__button" aria-label="{% if product.has_only_default_variant %}View product{% else %}Select options for {{ product.title | escape }}{% endif %}">
      {%- if product.available == false -%}
        Out of stock
      {%- elsif product.has_only_default_variant -%}
        View Product
      {%- else -%}
        Select Options
      {%- endif -%}
    </a>
  </div>
</article>
